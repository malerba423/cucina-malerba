# Copy to .env for local development. .env is git-ignored.

# Local Postgres from `npm run db:up` (docker compose).
# For Neon, paste the pooled connection string instead.
DATABASE_URL=postgres://cucina:cucina@localhost:5433/cucina

PORT=8080

# Sign-in (milestone 3)
# Your email: the first sign-in with it becomes the owner (only while no owner exists).
OWNER_EMAIL=you@example.com
# Leave empty locally: sign-in emails are printed in the terminal instead of sent.
RESEND_API_KEY=

# Recipe photos (milestone 4)
# Leave empty locally: photos are saved in .uploads/ and served at /media.
GCS_BUCKET=
